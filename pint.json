{
    "preset": "laravel",
    "rules": {
        "binary_operator_spaces": {
            "default": "single_space",
            "operators": {
                "=": "align_single_space_minimal",
                "=>": "align_single_space_minimal"
            }
        },
        "blank_line_before_statement": {
            "statements": [
                "if",
                "for",
                "foreach",
                "break",
                "continue",
                "declare",
                "return",
                "throw",
                "try",
                "switch"
            ]
        },
        "concat_space": {
            "spacing": "one"
        },
        "phpdoc_align": true,
        "single_quote": true,
        "no_unused_imports": true
    }
}
